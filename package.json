{
  "name": "abs-fengsheng",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "《风声再临》线上版 —— 核心战斗模块 + 数据配置工具",
  "scripts": {
    "balance": "tsx scripts/balance-test.ts 100",
    "build": "tsc --noEmit && vite build",
    "check:play": "tsx scripts/verify-play-link.ts",
    "check:online": "tsx scripts/verify-online-prod.ts",
    "check:multi": "tsx scripts/verify-invite-multi.ts",
    "check:7p": "tsx scripts/verify-seven.ts",
    "check:local": "tsx scripts/verify-local-modes.ts",
    "check:restart": "tsx scripts/verify-restart-client.ts",
    "check:viewports": "tsx scripts/verify-viewports.ts",
    "check:lobby": "tsx scripts/verify-lobby-rows.ts",
    "check:modes": "tsx scripts/verify-local-modes.ts",
    "check:result": "tsx scripts/verify-result-overlay.ts",
    "check:spectator": "tsx scripts/verify-spectator.ts",
    "check:discard": "tsx scripts/verify-discard.ts",
    "check:response": "tsx scripts/verify-response.ts",
    "shots:budget": "tsx scripts/shots-narrow-budget.ts",
    "dev": "vite",
    "dev:all": "concurrently -n web,srv -c cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "serve": "npm run build && npm run server",
    "start": "tsx server/index.ts",
    "shots": "tsx scripts/shots.ts",
    "shots:latejoin": "tsx scripts/shots-latejoin.ts",
    "shots:password": "tsx scripts/shots-password.ts",
    "shots:rematch": "tsx scripts/shots-rematch.ts",
    "shots:seats": "tsx scripts/shots-seats.ts",
    "shots:ghost": "tsx scripts/shots-lobby-ghost.ts",
    "shots:result": "tsx scripts/shots-result-fit.ts",
    "shots:spectate": "tsx scripts/shots-spectate.ts",
    "test": "tsx scripts/smoke-test.ts 10",
    "test:all": "npm run typecheck && npm run validate && npm run test && npm run test:feature && npm run test:ui && npm run test:server && npm run test:prod",
    "test:feature": "tsx scripts/feature-test.ts",
    "test:prod": "tsx scripts/server-prod-test.ts",
    "test:server": "tsx scripts/server-test.ts",
    "test:ui": "tsx scripts/ui-smoke.tsx && tsx scripts/ui-interaction.tsx && tsx scripts/ui-online.tsx",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "engines": {
    "node": ">=20"
  }
}
